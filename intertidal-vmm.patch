+static void * ggml_backend_cuda_hybrid_buffer_get_base(ggml_backend_buffer_t buffer) {
+    auto * ctx = static_cast<ggml_backend_cuda_hybrid_buffer_context *>(buffer->context);
+    return reinterpret_cast<void *>(ctx->base);
